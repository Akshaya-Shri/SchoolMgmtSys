generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STAFF
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff?
  student   Student?
}

model Staff {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  email              String?
  phone              String?
  classesTaught      Class[]                  @relation("ClassTeacher")
  subjectAssignments StaffSubjectAssignment[]
  markedAttendance   Attendance[]             @relation("MarkedBy")
  enteredMarks       ExamMark[]               @relation("MarkedBy")
  workDoneRecords    WorkDone[]
  homeworkAssigned   Homework[]
  reviewedLeaves     LeaveRequest[]           @relation("ReviewedBy")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model Class {
  id                 String                   @id @default(uuid())
  grade              String // e.g., "8"
  section            String // e.g., "A"
  name               String                   // "8-A"
  classTeacherId     String?                  @unique
  classTeacher       Staff?                   @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  academicYearId     String?
  academicYear       AcademicYear?            @relation(fields: [academicYearId], references: [id])
  students           Student[]
  subjectAssignments StaffSubjectAssignment[]
  workDoneRecords    WorkDone[]
  homework           Homework[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([grade, section, academicYearId])
}

model Subject {
  id                 String                   @id @default(uuid())
  name               String                   @unique // e.g., "Science"
  subjectAssignments StaffSubjectAssignment[]
  examSubjects       ExamSubject[]
  workDoneRecords    WorkDone[]
  homework           Homework[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model StaffSubjectAssignment {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, classId, subjectId])
}

model Student {
  id               String            @id @default(uuid()) // STU20260001
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNumber  String            @unique
  name             String
  dob              DateTime
  gender           Gender
  classId          String
  class            Class             @relation(fields: [classId], references: [id])
  guardianContacts GuardianContact[]
  attendance       Attendance[]
  examMarks        ExamMark[]
  leaveRequests    LeaveRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model GuardianContact {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  relation  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

model Attendance {
  id             String           @id @default(uuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           DateTime // Stored as Date only (midnight)
  status         AttendanceStatus
  markedById     String
  markedBy       Staff            @relation("MarkedBy", fields: [markedById], references: [id])
  academicYearId String?
  academicYear   AcademicYear?    @relation(fields: [academicYearId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([date])
}

model AcademicYear {
  id            String         @id @default(uuid())
  label         String         @unique
  startDate     DateTime
  endDate       DateTime
  classes       Class[]
  exams         Exam[]
  attendance    Attendance[]
  homework      Homework[]
  workDone      WorkDone[]
  leaveRequests LeaveRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Exam {
  id             String        @id @default(uuid())
  name           String
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  examSubjects   ExamSubject[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([name, academicYearId])
}

model ExamSubject {
  id        String     @id @default(uuid())
  examId    String
  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  maxMark   Float
  examMarks ExamMark[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([examId, subjectId])
}

model ExamMark {
  id            String      @id @default(uuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  obtainedMark  Float
  markedById    String
  markedBy      Staff       @relation("MarkedBy", fields: [markedById], references: [id])
  isDraft       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([studentId, examSubjectId])
}

model WorkDone {
  id             String        @id @default(uuid())
  date           DateTime
  classId        String
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  topic          String
  description    String?
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Homework {
  id             String               @id @default(uuid())
  classId        String
  class          Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff                @relation(fields: [staffId], references: [id], onDelete: Cascade)
  title          String
  description    String
  assignedDate   DateTime             @default(now())
  dueDate        DateTime
  academicYearId String?
  academicYear   AcademicYear?        @relation(fields: [academicYearId], references: [id])
  attachments    HomeworkAttachment[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model HomeworkAttachment {
  id         String   @id @default(uuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  fileType   String
  fileSize   Int
  createdAt  DateTime @default(now())
}

model LeaveRequest {
  id             String                   @id @default(uuid())
  studentId      String
  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         LeaveStatus              @default(PENDING)
  remarks        String?
  reviewedById   String?
  reviewedBy     Staff?                   @relation("ReviewedBy", fields: [reviewedById], references: [id])
  academicYearId String?
  academicYear   AcademicYear?            @relation(fields: [academicYearId], references: [id])
  attachments    LeaveRequestAttachment[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model LeaveRequestAttachment {
  id             String       @id @default(uuid())
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  fileName       String
  filePath       String
  fileType       String
  fileSize       Int
  createdAt      DateTime     @default(now())
}
